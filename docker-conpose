services:
  db:
    image: postgres:16-alpine
    restart: unless-stopped
    environment:
      POSTGRES_DB: teaching_scheduler
      POSTGRES_USER: teacher
      POSTGRES_PASSWORD: changeme
    volumes:
      - postgres_data:/var/lib/postgresql/data
    ports:
      - "5432:5432"

  web:
    build: .
    restart: unless-stopped
    # Dùng runserver khi dev để có auto-reload; đổi sang CMD trong Dockerfile khi deploy production
    command: python manage.py runserver 0.0.0.0:8000
    volumes:
      - .:/app
    ports:
      - "8000:8000"
    env_file:
      - .env
    depends_on:
      - db

  # Optional: chỉ cần nếu dùng Django-Q/Celery để chạy job tự sinh Session hàng tuần
  worker:
    build: .
    restart: unless-stopped
    command: python manage.py qcluster
    volumes:
      - .:/app
    env_file:
      - .env
    depends_on:
      - db

volumes:
  postgres_data: